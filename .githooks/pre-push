#!/usr/bin/env bash
#
# grimoire pre-push hook — plugin version discipline.
#
# Enforces two rules for every plugin under plugins/<name>/ in the range being
# pushed:
#
#   1. Bump rule. If a plugin's tracked content differs from main, its
#      plugin.json "version" must also differ from main — so one bump per branch
#      covers all its iterative pushes. Content changes without a version bump
#      leave users on a stale, version-stamped cache.
#   2. Lockstep rule. A plugin's plugin.json "version" must equal the "version"
#      in its .claude-plugin/marketplace.json entry. Checked repo-wide for every
#      versioned plugin at the tip (not only changed ones), so any pre-existing
#      drift blocks the push until it is fixed.
#
# A plugin with no "version" field (commit-SHA versioning, e.g. a plugin that
# opts out) is tolerated: both rules are skipped for it with a warning.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push   # git tracks the +x bit, but set it if missing
#
# Bypass in an emergency with:  git push --no-verify
#
# See RELEASING.md for the full release workflow and the {plugin}--v{version}
# tag convention.

set -euo pipefail

readonly ZERO_SHA="0000000000000000000000000000000000000000"
readonly MARKETPLACE=".claude-plugin/marketplace.json"

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

fail=0

warn()  { printf 'pre-push: warning: %s\n' "$1" >&2; }
error() { printf 'pre-push: error: %s\n' "$1" >&2; }

# The checks need python3 to read JSON. If it is unavailable, fail open with a
# loud warning rather than blocking every push on a machine without it.
if ! command -v python3 >/dev/null 2>&1; then
  warn "python3 not found; skipping plugin version checks (see RELEASING.md)."
  exit 0
fi

# Read plugin.json "version" for <plugin> at a git revision. Empty if the file,
# the field, or the revision is absent, or the JSON is malformed.
plugin_version_at() {
  local rev="$1" name="$2" json
  json="$(git show "$rev:plugins/$name/.claude-plugin/plugin.json" 2>/dev/null)" || return 0
  printf '%s' "$json" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("version",""))
except Exception:
    pass' 2>/dev/null || true
}

# Read the marketplace.json entry "version" for <plugin> at a git revision.
marketplace_version_at() {
  local rev="$1" name="$2" json
  json="$(git show "$rev:$MARKETPLACE" 2>/dev/null)" || return 0
  printf '%s' "$json" | python3 -c 'import json,sys
name = sys.argv[1]
try:
    for e in json.load(sys.stdin).get("plugins", []):
        if e.get("name") == name:
            print(e.get("version", ""))
            break
except Exception:
    pass' "$name" 2>/dev/null || true
}

# Validate every plugin present at <tip>, using <base> as the diff baseline.
check_range() {
  local base="$1" tip="$2" name ppath old_v new_v mk_v

  while IFS= read -r name; do
    [ -z "$name" ] && continue
    ppath="plugins/$name/.claude-plugin/plugin.json"
    # Only treat directories that carry a manifest at the tip as plugins.
    git cat-file -e "$tip:$ppath" 2>/dev/null || continue

    new_v="$(plugin_version_at "$tip" "$name")"

    # A version-less plugin opts out of both checks.
    if [ -z "$new_v" ]; then
      if ! git diff --quiet "$base" "$tip" -- "plugins/$name/"; then
        warn "plugin '$name' has no version field; skipping bump check."
      fi
      continue
    fi

    # Bump rule: content changed but version did not.
    if ! git diff --quiet "$base" "$tip" -- "plugins/$name/"; then
      old_v="$(plugin_version_at "$base" "$name")"
      if [ "$old_v" = "$new_v" ]; then
        error "plugin '$name' changed but version stayed $new_v."
        error "  Bump \"version\" in plugins/$name/.claude-plugin/plugin.json"
        error "  and the matching entry in $MARKETPLACE."
        fail=1
      fi
    fi

    # Lockstep rule: plugin.json and marketplace.json must agree at the tip.
    mk_v="$(marketplace_version_at "$tip" "$name")"
    if [ "$new_v" != "$mk_v" ]; then
      error "version mismatch for '$name': plugin.json=$new_v marketplace.json=${mk_v:-<none>}."
      error "  Set both to the same version."
      fail=1
    fi
  done < <(git ls-tree --name-only "$tip:plugins" 2>/dev/null || true)
}

# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Skip branch/tag deletions (nothing to validate).
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  # Baseline the bump rule against main (the release line), not the last push,
  # so a single version bump per branch covers all of its iterative pushes. Use
  # the merge-base so an advancing main never spuriously flags a plugin this
  # branch did not touch.
  if main_sha="$(git rev-parse -q --verify origin/main 2>/dev/null)"; then
    base="$(git merge-base "$main_sha" "$local_sha" 2>/dev/null || printf '%s' "$main_sha")"
  else
    # No main to compare against (e.g. the very first push): use the empty tree,
    # so newly added versioned plugins register as a change and pass.
    base="$(git hash-object -t tree /dev/null)"
  fi

  check_range "$base" "$local_sha"
done

exit "$fail"
