{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r = process.env.PLUGIN_ROOT; if (r) require(r + '/hooks/scripts/sync-codex-agents.js')\""
          }
        ],
        "description": "Install this plugin's Codex agent roles (no-op outside Codex)"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r = process.env.CLAUDE_PLUGIN_ROOT; if (r) require(r + '/hooks/scripts/suggest-skills.js')\""
          }
        ],
        "description": "Re-arm skill activation after a compact (see the script header)"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-skills.js\""
          }
        ],
        "description": "Prompt the model to load the skills relevant to the task"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/suggest-compact.js\""
          }
        ],
        "description": "Suggest manual compaction at logical intervals"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-console-log.js\""
          }
        ],
        "description": "Check for console.log in changed files after an edit"
      }
    ]
  }
}
